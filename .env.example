# ==============================================================================
# DEVCORE SOLUTIONS — FRONTEND ENVIRONMENT CONFIGURATION
# ==============================================================================

# Backend API URL (Points to your Express backend, e.g. http://localhost:5000)
# When set, the frontend will automatically fetch live data from the backend database.
NEXT_PUBLIC_API_URL=http://localhost:5000

# Public Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional Direct Contact Info (Leave empty if managed via backend ContactSettings)
# NEXT_PUBLIC_WHATSAPP_NUMBER=8801700000000
# NEXT_PUBLIC_PHONE=+8801700000000
# NEXT_PUBLIC_EMAIL=solutions@devcoresolutions.com
# NEXT_PUBLIC_BOOKING_URL=https://cal.com/devcore-solutions/discovery
